{
  "name": "tf-plan-lens",
  "displayName": "Terraform Plan Lens",
  "description": "Your Terraform plan on your code: what each block will create, update, replace or destroy, risky changes first. Refactor without recreating (moved blocks), see values as you write, preview edits on save. Terraform & OpenTofu.",
  "version": "0.4.0",
  "publisher": "jay-boo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jay-boo/tf-plan-lens.git"
  },
  "bugs": {
    "url": "https://github.com/Jay-boo/tf-plan-lens/issues"
  },
  "homepage": "https://github.com/Jay-boo/tf-plan-lens#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Linters",
    "Other"
  ],
  "keywords": [
    "terraform",
    "opentofu",
    "plan",
    "hcl",
    "iac",
    "infrastructure as code",
    "aws",
    "azure",
    "gcp",
    "refactor",
    "moved",
    "drift",
    "devops"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.tf"
  ],
  "contributes": {
    "colors": [
      {
        "id": "planLens.create",
        "description": "Plan Lens: create (markers, hints, sidebar)",
        "defaults": {
          "dark": "testing.iconPassed",
          "light": "testing.iconPassed",
          "highContrast": "testing.iconPassed",
          "highContrastLight": "testing.iconPassed"
        }
      },
      {
        "id": "planLens.createBackground",
        "description": "Plan Lens: background band of a block that will create",
        "defaults": {
          "dark": "#73c99112",
          "light": "#388a3410",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "planLens.update",
        "description": "Plan Lens: update (markers, hints, sidebar)",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.yellow"
        }
      },
      {
        "id": "planLens.updateBackground",
        "description": "Plan Lens: background band of a block that will update",
        "defaults": {
          "dark": "#cca70012",
          "light": "#bf880310",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "planLens.replace",
        "description": "Plan Lens: replace (markers, hints, sidebar)",
        "defaults": {
          "dark": "charts.orange",
          "light": "charts.orange",
          "highContrast": "charts.orange",
          "highContrastLight": "charts.orange"
        }
      },
      {
        "id": "planLens.replaceBackground",
        "description": "Plan Lens: background band of a block that will replace",
        "defaults": {
          "dark": "#d1861612",
          "light": "#c27d0010",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "planLens.destroy",
        "description": "Plan Lens: destroy (markers, hints, sidebar)",
        "defaults": {
          "dark": "errorForeground",
          "light": "errorForeground",
          "highContrast": "errorForeground",
          "highContrastLight": "errorForeground"
        }
      },
      {
        "id": "planLens.destroyBackground",
        "description": "Plan Lens: background band of a block that will destroy",
        "defaults": {
          "dark": "#f8514912",
          "light": "#e5140010",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "planLens.read",
        "description": "Plan Lens: read (markers, hints, sidebar)",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue",
          "highContrastLight": "charts.blue"
        }
      },
      {
        "id": "planLens.readBackground",
        "description": "Plan Lens: background band of a block that will be read",
        "defaults": {
          "dark": "#3794ff12",
          "light": "#1a85ff10",
          "highContrast": null,
          "highContrastLight": null
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "planLens",
          "title": "Plan Lens",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "planLens": [
        {
          "type": "webview",
          "id": "planLens.view",
          "name": "Plan",
          "when": "planLens.hasTerraform"
        }
      ]
    },
    "commands": [
      {
        "command": "planLens.runPlan",
        "title": "Run plan…",
        "category": "Plan Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "planLens.loadPlan",
        "title": "Load plan file…",
        "category": "Plan Lens",
        "icon": "$(folder-opened)"
      },
      {
        "command": "planLens.pickEnv",
        "title": "Pick environment…",
        "category": "Plan Lens"
      },
      {
        "command": "planLens.findWorkspaces",
        "title": "Find workspaces…",
        "category": "Plan Lens",
        "icon": "$(layers)"
      },
      {
        "command": "planLens.setEnvFolder",
        "title": "Set environments folder…",
        "category": "Plan Lens",
        "icon": "$(folder-library)"
      },
      {
        "command": "planLens.targetPlan",
        "title": "Plan with targets…",
        "category": "Plan Lens",
        "icon": "$(target)"
      },
      {
        "command": "planLens.apply",
        "title": "Apply plan…",
        "category": "Plan Lens",
        "icon": "$(rocket)"
      },
      {
        "command": "planLens.clear",
        "title": "Clear plan",
        "category": "Plan Lens",
        "icon": "$(clear-all)"
      },
      {
        "command": "planLens.openLog",
        "title": "Open log",
        "category": "Plan Lens",
        "icon": "$(output)"
      },
      {
        "command": "planLens.reveal",
        "title": "Show in plan",
        "category": "Plan Lens"
      },
      {
        "command": "planLens.copyAddress",
        "title": "Copy address",
        "category": "Plan Lens"
      },
      {
        "command": "planLens.writeMoves",
        "title": "Add moved block",
        "category": "Plan Lens"
      },
      {
        "command": "planLens.evaluateSelection",
        "title": "Evaluate selection",
        "category": "Plan Lens",
        "icon": "$(symbol-variable)"
      },
      {
        "command": "planLens.openSettingsPage",
        "title": "Settings",
        "category": "Plan Lens",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "planLens.runPlan",
          "when": "view == planLens.view",
          "group": "navigation@1"
        },
        {
          "command": "planLens.loadPlan",
          "when": "view == planLens.view",
          "group": "1_plan@1"
        },
        {
          "command": "planLens.pickEnv",
          "when": "view == planLens.view",
          "group": "1_plan@2"
        },
        {
          "command": "planLens.setEnvFolder",
          "when": "view == planLens.view",
          "group": "1_plan@3"
        },
        {
          "command": "planLens.findWorkspaces",
          "when": "view == planLens.view",
          "group": "1_plan@3"
        },
        {
          "command": "planLens.targetPlan",
          "when": "view == planLens.view",
          "group": "1_plan@4"
        },
        {
          "command": "planLens.apply",
          "when": "view == planLens.view && config.planLens.allowApply",
          "group": "1_plan@5"
        },
        {
          "command": "planLens.clear",
          "when": "view == planLens.view",
          "group": "2_misc@1"
        },
        {
          "command": "planLens.openLog",
          "when": "view == planLens.view",
          "group": "2_misc@2"
        },
        {
          "command": "planLens.openSettingsPage",
          "when": "view == planLens.view",
          "group": "2_misc@3"
        }
      ],
      "commandPalette": [
        {
          "command": "planLens.reveal",
          "when": "false"
        },
        {
          "command": "planLens.copyAddress",
          "when": "false"
        },
        {
          "command": "planLens.apply",
          "when": "config.planLens.allowApply"
        },
        {
          "command": "planLens.writeMoves",
          "when": "false"
        },
        {
          "command": "planLens.evaluateSelection",
          "when": "editorLangId == terraform || resourceExtname == .tf"
        }
      ],
      "editor/context": [
        {
          "command": "planLens.evaluateSelection",
          "when": "resourceExtname == .tf && editorHasSelection",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Terraform Plan Lens",
      "properties": {
        "planLens.environmentsFolder": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Folder that holds the environments (absolute, or relative to the first workspace folder). Each subfolder with a `terraform.tfvars`, and each `*.tfvars` file in it, is an environment (`*.auto.tfvars` excepted); a `backend.conf` (or `<env>.backend.conf`) next to it is used for init. Overrides `#planLens.environmentGlob#`. Set it with **Plan Lens: Set environments folder…**."
        },
        "planLens.environmentGlob": {
          "type": "string",
          "default": "environments/**/terraform.tfvars",
          "markdownDescription": "Glob (from the workspace) of the tfvars files that define environments, used when `#planLens.environmentsFolder#` is empty. A `backend.conf` next to one is used for init. Terraform folders without such tfvars are offered too, planned as they are (once per workspace)."
        },
        "planLens.root": {
          "type": "string",
          "default": "",
          "markdownDescription": "Terraform root folder (absolute, or relative to the first workspace folder). Empty: each `environments/` folder plans its parent, and every other folder with `.tf` files that is not a local module plans as it is."
        },
        "planLens.terraformPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Terraform (or OpenTofu) binary. Empty: `terraform`, or `tofu` when only OpenTofu is installed."
        },
        "planLens.allowApply": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show an **Apply** button after a plan run from Plan Lens. It runs `terraform apply` on that exact saved plan, after a confirmation (and typing the environment name when the plan destroys or replaces something), then plans again."
        },
        "planLens.showUnchanged": {
          "type": "boolean",
          "default": true,
          "description": "Show a faint \"no changes\" hint on blocks the plan leaves alone."
        },
        "planLens.inlineValues": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what locals, variables, `for_each` / `count` and outputs of the environment's root module evaluate to, at the end of their line and in a hover. Computed by `terraform console` on Plan Lens's own copy of the configuration with the environment's variables — never on the real state."
        },
        "planLens.sidebar.drift": {
          "type": "string",
          "enum": [
            "shown",
            "discreet",
            "hidden"
          ],
          "enumDescriptions": [
            "A section in the sidebar",
            "One faint line, opened on click",
            "Not shown"
          ],
          "default": "discreet",
          "markdownDescription": "Sidebar: objects **changed outside Terraform** since the last apply."
        },
        "planLens.sidebar.imports": {
          "type": "string",
          "enum": [
            "shown",
            "discreet",
            "hidden"
          ],
          "enumDescriptions": [
            "A section in the sidebar",
            "One faint line, opened on click",
            "Not shown"
          ],
          "default": "shown",
          "markdownDescription": "Sidebar: objects `import` blocks bring under Terraform."
        },
        "planLens.sidebar.moved": {
          "type": "string",
          "enum": [
            "shown",
            "discreet",
            "hidden"
          ],
          "enumDescriptions": [
            "A section in the sidebar",
            "One faint line, opened on click",
            "Not shown"
          ],
          "default": "shown",
          "markdownDescription": "Sidebar: objects `moved` blocks move to a new address."
        },
        "planLens.sidebar.reads": {
          "type": "string",
          "enum": [
            "shown",
            "discreet",
            "hidden"
          ],
          "enumDescriptions": [
            "A section in the sidebar",
            "One faint line, opened on click",
            "Not shown"
          ],
          "default": "discreet",
          "markdownDescription": "Sidebar: data sources read during the plan."
        },
        "planLens.sidebar.outputs": {
          "type": "string",
          "enum": [
            "shown",
            "discreet",
            "hidden"
          ],
          "enumDescriptions": [
            "A section in the sidebar",
            "One faint line, opened on click",
            "Not shown"
          ],
          "default": "shown",
          "markdownDescription": "Sidebar: outputs the plan changes (sensitive values are never shown)."
        },
        "planLens.refactor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Refactor autopilot**: spot destroys that are objects moved to a new address and offer `moved` blocks (sidebar card, editor hints, quick fix)."
        },
        "planLens.editorMarkers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the plan on the code: gutter icon, coloured band and end-of-line hint on changed blocks."
        },
        "planLens.preview": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Preview edits on save**: once an environment has been planned here, saving a `.tf` file plans just the blocks you edited (`-target`, `-refresh=false`, `-lock=false`: read only, never applied) and says on the edited lines what that would do."
        },
        "planLens.completions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Completions from your data**: complete map keys and object fields from the evaluated values (`local.x[\"…\"]`, `each.value.…`, `var.x.…`). Needs `#planLens.inlineValues#`."
        },
        "planLens.style.accent": {
          "type": "string",
          "enum": [
            "aurora",
            "sunset",
            "forest",
            "terraform",
            "mono",
            "custom"
          ],
          "default": "aurora",
          "markdownDescription": "Accent gradient of the Plan Lens views. `mono` follows your theme's accent; `custom` uses `#planLens.style.customColors#`."
        },
        "planLens.style.customColors": {
          "type": "string",
          "default": "#8b5cf6, #06b6d4",
          "markdownDescription": "With the `custom` accent: 2 or 3 hex colours, comma separated."
        },
        "planLens.style.corners": {
          "type": "string",
          "enum": [
            "sharp",
            "soft",
            "round"
          ],
          "default": "sharp",
          "description": "How round boxes, badges and buttons are."
        },
        "planLens.style.density": {
          "type": "string",
          "enum": [
            "compact",
            "comfortable"
          ],
          "default": "comfortable",
          "description": "Room around rows and cards."
        },
        "planLens.style.motion": {
          "type": "string",
          "enum": [
            "subtle",
            "full",
            "off"
          ],
          "default": "subtle",
          "markdownDescription": "`subtle`: a new plan slides in, nothing loops. `full`: the header rule drifts slowly, rules draw in, hovered entries extend their mark. `off`: still (also when the system asks for reduced motion)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:unit": "node test/unit/build.mjs && node --test test/unit/",
    "render": "node test/render/render.mjs",
    "package": "npm run typecheck && node -r ./scripts/file-shim.cjs ../gitland/node_modules/@vscode/vsce/vsce package --no-dependencies",
    "e2e": "node esbuild.mjs && node test/e2e/runTest.js",
    "demo": "node test/demo/record.mjs"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1a1e2c",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Plan Lens shows loaded plan files, but runs terraform (which runs the workspace's providers and modules) only in trusted workspaces.",
      "restrictedConfigurations": [
        "planLens.terraformPath",
        "planLens.root",
        "planLens.environmentsFolder"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Plan Lens runs terraform on local files."
    }
  }
}
