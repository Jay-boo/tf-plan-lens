{
  "name": "tf-plan-lens",
  "displayName": "Terraform Plan Lens",
  "description": "See your Terraform plan on the code: what each resource block will create, update, replace or destroy, with the risky changes first.",
  "version": "0.1.0",
  "publisher": "jay-boo",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization", "Other"],
  "keywords": ["terraform", "plan", "hcl", "infrastructure", "azure"],
  "main": "./dist/extension.js",
  "activationEvents": ["workspaceContains:**/*.tf"],
  "contributes": {},
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:unit": "node test/unit/build.mjs && node --test test/unit/",
    "render": "node test/render/render.mjs",
    "package": "npm run typecheck && node -r ./scripts/file-shim.cjs ../gitland/node_modules/@vscode/vsce/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
