{
  "name": "tf-plan-lens",
  "displayName": "Terraform Plan Lens",
  "description": "See your Terraform plan on the code: what each resource block will create, update, replace or destroy, with the risky changes first.",
  "version": "0.3.0",
  "publisher": "jay-boo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "terraform",
    "plan",
    "hcl",
    "infrastructure",
    "azure"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.tf"
  ],
  "contributes": {
    "colors": [
      {
        "id": "planLens.create",
        "description": "Plan Lens: create (markers, hints, sidebar)",
        "defaults": {
          "dark": "testing.iconPassed",
          "light": "testing.iconPassed",
          "highContrast": "testing.iconPassed",
          "highContrastLight": "testing.iconPassed"
        }
      },
      {
        "id": "planLens.createBackground",
        "description": "Plan Lens: background band of a block that will create",
        "defaults": {
          "dark": "#73c99112",
          "light": "#388a3410",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "planLens.update",
        "description": "Plan Lens: update (markers, hints, sidebar)",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.yellow",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.yellow"
        }
      },
      {
        "id": "planLens.updateBackground",
        "description": "Plan Lens: background band of a block that will update",
        "defaults": {
          "dark": "#cca70012",
          "light": "#bf880310",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "planLens.replace",
        "description": "Plan Lens: replace (markers, hints, sidebar)",
        "defaults": {
          "dark": "charts.orange",
          "light": "charts.orange",
          "highContrast": "charts.orange",
          "highContrastLight": "charts.orange"
        }
      },
      {
        "id": "planLens.replaceBackground",
        "description": "Plan Lens: background band of a block that will replace",
        "defaults": {
          "dark": "#d1861612",
          "light": "#c27d0010",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "planLens.destroy",
        "description": "Plan Lens: destroy (markers, hints, sidebar)",
        "defaults": {
          "dark": "errorForeground",
          "light": "errorForeground",
          "highContrast": "errorForeground",
          "highContrastLight": "errorForeground"
        }
      },
      {
        "id": "planLens.destroyBackground",
        "description": "Plan Lens: background band of a block that will destroy",
        "defaults": {
          "dark": "#f8514912",
          "light": "#e5140010",
          "highContrast": null,
          "highContrastLight": null
        }
      },
      {
        "id": "planLens.read",
        "description": "Plan Lens: read (markers, hints, sidebar)",
        "defaults": {
          "dark": "charts.blue",
          "light": "charts.blue",
          "highContrast": "charts.blue",
          "highContrastLight": "charts.blue"
        }
      },
      {
        "id": "planLens.readBackground",
        "description": "Plan Lens: background band of a block that will be read",
        "defaults": {
          "dark": "#3794ff12",
          "light": "#1a85ff10",
          "highContrast": null,
          "highContrastLight": null
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "planLens",
          "title": "Plan Lens",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "planLens": [
        {
          "type": "webview",
          "id": "planLens.view",
          "name": "Plan",
          "when": "planLens.hasTerraform"
        }
      ]
    },
    "commands": [
      {
        "command": "planLens.runPlan",
        "title": "Run plan…",
        "category": "Plan Lens",
        "icon": "$(refresh)"
      },
      {
        "command": "planLens.loadPlan",
        "title": "Load plan file…",
        "category": "Plan Lens",
        "icon": "$(folder-opened)"
      },
      {
        "command": "planLens.pickEnv",
        "title": "Pick environment…",
        "category": "Plan Lens"
      },
      {
        "command": "planLens.setEnvFolder",
        "title": "Set environments folder…",
        "category": "Plan Lens",
        "icon": "$(folder-library)"
      },
      {
        "command": "planLens.targetPlan",
        "title": "Plan with targets…",
        "category": "Plan Lens",
        "icon": "$(target)"
      },
      {
        "command": "planLens.apply",
        "title": "Apply plan…",
        "category": "Plan Lens",
        "icon": "$(rocket)"
      },
      {
        "command": "planLens.clear",
        "title": "Clear plan",
        "category": "Plan Lens",
        "icon": "$(clear-all)"
      },
      {
        "command": "planLens.openLog",
        "title": "Open log",
        "category": "Plan Lens",
        "icon": "$(output)"
      },
      {
        "command": "planLens.reveal",
        "title": "Show in plan",
        "category": "Plan Lens"
      },
      {
        "command": "planLens.copyAddress",
        "title": "Copy address",
        "category": "Plan Lens"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "planLens.runPlan",
          "when": "view == planLens.view",
          "group": "navigation@1"
        },
        {
          "command": "planLens.loadPlan",
          "when": "view == planLens.view",
          "group": "1_plan@1"
        },
        {
          "command": "planLens.pickEnv",
          "when": "view == planLens.view",
          "group": "1_plan@2"
        },
        {
          "command": "planLens.setEnvFolder",
          "when": "view == planLens.view",
          "group": "1_plan@3"
        },
        {
          "command": "planLens.targetPlan",
          "when": "view == planLens.view",
          "group": "1_plan@4"
        },
        {
          "command": "planLens.apply",
          "when": "view == planLens.view && config.planLens.allowApply",
          "group": "1_plan@5"
        },
        {
          "command": "planLens.clear",
          "when": "view == planLens.view",
          "group": "2_misc@1"
        },
        {
          "command": "planLens.openLog",
          "when": "view == planLens.view",
          "group": "2_misc@2"
        }
      ],
      "commandPalette": [
        {
          "command": "planLens.reveal",
          "when": "false"
        },
        {
          "command": "planLens.copyAddress",
          "when": "false"
        },
        {
          "command": "planLens.apply",
          "when": "config.planLens.allowApply"
        }
      ]
    },
    "configuration": {
      "title": "Terraform Plan Lens",
      "properties": {
        "planLens.environmentsFolder": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Folder that holds the environments (absolute, or relative to the first workspace folder). Each subfolder with a `terraform.tfvars`, and each `*.tfvars` file in it, is an environment (`*.auto.tfvars` excepted); a `backend.conf` (or `<env>.backend.conf`) next to it is used for init. Overrides `#planLens.environmentGlob#`. Set it with **Plan Lens: Set environments folder…**."
        },
        "planLens.environmentGlob": {
          "type": "string",
          "default": "environments/**/terraform.tfvars",
          "markdownDescription": "Glob (from the workspace) of the tfvars files that define environments, used when `#planLens.environmentsFolder#` is empty. A `backend.conf` next to one is used for init."
        },
        "planLens.root": {
          "type": "string",
          "default": "",
          "description": "Terraform root folder (absolute, or relative to the first workspace folder). Empty: the parent of the environments folder."
        },
        "planLens.terraformPath": {
          "type": "string",
          "default": "terraform",
          "description": "Terraform binary."
        },
        "planLens.allowApply": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show an **Apply** button after a plan run from Plan Lens. It runs `terraform apply` on that exact saved plan, after a confirmation (and typing the environment name when the plan destroys or replaces something), then plans again."
        },
        "planLens.showUnchanged": {
          "type": "boolean",
          "default": true,
          "description": "Show a faint \"no changes\" hint on blocks the plan leaves alone."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "test:unit": "node test/unit/build.mjs && node --test test/unit/",
    "render": "node test/render/render.mjs",
    "package": "npm run typecheck && node -r ./scripts/file-shim.cjs ../gitland/node_modules/@vscode/vsce/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1d2129",
    "theme": "dark"
  }
}
